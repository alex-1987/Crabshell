{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crabshell",
  "version": "0.2.7",
  "identifier": "dev.crabshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crabshell",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local SSH manager and terminal",
    "longDescription": "Crabshell is a local SSH manager and terminal built on the system OpenSSH client. Server profiles, keys and known_hosts stay on your device. Supports tabs, local shells, per-server designs and light/dark themes.",
    "publisher": "Crabshell",
    "license": "MIT OR Apache-2.0",
    "copyright": "Copyright (c) 2026 Alex (alex-1987) and Crabshell contributors",
    "homepage": "https://github.com/alex-1987/Crabshell",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "depends": [
          "openssh-client"
        ]
      },
      "rpm": {
        "depends": [
          "openssh-clients"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
