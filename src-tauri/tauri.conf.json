{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crabshell",
  "version": "0.1.0",
  "identifier": "dev.crabshell.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Crabshell",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "A local OpenSSH terminal manager",
    "targets": ["deb", "appimage"]
  }
}
